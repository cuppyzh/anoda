{
  "$schema": "./tokens.schema.json",
  "$comment": "Single source of design tokens (docs/contracts/12-design-ui-ux.md). Colors are HSL triplets without hsl() so Tailwind opacity modifiers work. Every role exists in both themes. Changing a token requires an ADR and `node tooling/design/check-contrast.mjs` must pass.",
  "color": {
    "light": {
      "background": "0 0% 100%",
      "foreground": "240 10% 4%",
      "card": "0 0% 100%",
      "card-foreground": "240 10% 4%",
      "popover": "0 0% 100%",
      "popover-foreground": "240 10% 4%",
      "primary": "243 75% 59%",
      "primary-foreground": "0 0% 100%",
      "secondary": "240 5% 96%",
      "secondary-foreground": "240 6% 10%",
      "muted": "240 5% 96%",
      "muted-foreground": "240 5% 34%",
      "accent": "240 5% 96%",
      "accent-foreground": "240 6% 10%",
      "destructive": "0 72% 51%",
      "destructive-foreground": "0 0% 100%",
      "success": "142 72% 29%",
      "success-foreground": "0 0% 100%",
      "warning": "26 90% 37%",
      "warning-foreground": "0 0% 100%",
      "info": "201 96% 32%",
      "info-foreground": "0 0% 100%",
      "border": "240 6% 90%",
      "input": "240 6% 90%",
      "ring": "243 75% 59%"
    },
    "dark": {
      "background": "240 10% 4%",
      "foreground": "0 0% 98%",
      "card": "240 10% 6%",
      "card-foreground": "0 0% 98%",
      "popover": "240 10% 6%",
      "popover-foreground": "0 0% 98%",
      "primary": "234 89% 74%",
      "primary-foreground": "240 10% 4%",
      "secondary": "240 4% 16%",
      "secondary-foreground": "0 0% 98%",
      "muted": "240 4% 16%",
      "muted-foreground": "240 5% 70%",
      "accent": "240 4% 16%",
      "accent-foreground": "0 0% 98%",
      "destructive": "0 91% 71%",
      "destructive-foreground": "240 10% 4%",
      "success": "142 69% 58%",
      "success-foreground": "240 10% 4%",
      "warning": "43 96% 56%",
      "warning-foreground": "240 10% 4%",
      "info": "199 89% 48%",
      "info-foreground": "240 10% 4%",
      "border": "240 4% 16%",
      "input": "240 4% 16%",
      "ring": "234 89% 74%"
    }
  },
  "contrast": {
    "$comment": "Pairs checked in both themes by check-contrast.mjs. 'text' requires >= 4.5:1, 'ui' requires >= 3:1.",
    "text": [
      ["foreground", "background"],
      ["card-foreground", "card"],
      ["popover-foreground", "popover"],
      ["primary-foreground", "primary"],
      ["secondary-foreground", "secondary"],
      ["muted-foreground", "muted"],
      ["muted-foreground", "background"],
      ["accent-foreground", "accent"],
      ["destructive-foreground", "destructive"],
      ["success-foreground", "success"],
      ["warning-foreground", "warning"],
      ["info-foreground", "info"],
      ["primary", "background"],
      ["destructive", "background"]
    ],
    "ui": [
      ["ring", "background"],
      ["primary", "card"],
      ["success", "background"],
      ["warning", "background"],
      ["info", "background"]
    ]
  },
  "radius": {
    "base": "0.5rem",
    "sm": "calc(var(--radius) - 4px)",
    "md": "calc(var(--radius) - 2px)",
    "lg": "var(--radius)",
    "xl": "calc(var(--radius) + 4px)",
    "full": "9999px"
  },
  "fontFamily": {
    "sans": ["var(--font-sans)", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
    "mono": ["var(--font-mono)", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
  },
  "fontSize": {
    "xs": ["0.75rem", { "lineHeight": "1rem" }],
    "sm": ["0.875rem", { "lineHeight": "1.25rem" }],
    "base": ["1rem", { "lineHeight": "1.5rem" }],
    "lg": ["1.125rem", { "lineHeight": "1.75rem" }],
    "xl": ["1.25rem", { "lineHeight": "1.75rem" }],
    "2xl": ["1.5rem", { "lineHeight": "2rem" }],
    "3xl": ["1.875rem", { "lineHeight": "2.25rem" }],
    "4xl": ["2.25rem", { "lineHeight": "2.5rem" }]
  },
  "boxShadow": {
    "sm": "0 1px 2px 0 hsl(240 10% 4% / 0.05)",
    "md": "0 4px 6px -1px hsl(240 10% 4% / 0.08), 0 2px 4px -2px hsl(240 10% 4% / 0.06)",
    "lg": "0 10px 15px -3px hsl(240 10% 4% / 0.10), 0 4px 6px -4px hsl(240 10% 4% / 0.06)"
  },
  "motion": {
    "duration": { "fast": "150ms", "normal": "250ms", "slow": "400ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "emphasized": "cubic-bezier(0.05, 0.7, 0.1, 1)" }
  },
  "zIndex": {
    "dropdown": "1000",
    "sticky": "1100",
    "overlay": "1200",
    "modal": "1300",
    "popover": "1400",
    "toast": "1500"
  },
  "screens": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "container": {
    "maxWidth": "72rem",
    "gutter": { "base": "1rem", "sm": "1.5rem", "lg": "2rem" }
  }
}
