# syntax=docker/dockerfile:1.7
# Reference Dockerfile for Next.js apps (output: "standalone"). Copy to services/<name>.ui.anoda.com/Dockerfile.
# Rules: docs/contracts/09-containers-and-deploy.md
#
# Pin base image by DIGEST before first real use and refresh monthly:
#   docker buildx imagetools inspect node:22-alpine | grep Digest

ARG NODE_VERSION=22
ARG GIT_SHA=dev
ARG BUILD_DATE=unknown

# ---------- deps ----------
FROM node:${NODE_VERSION}-alpine AS deps
# TODO(pin): FROM node:22-alpine@sha256:<digest> AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ---------- build ----------
FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app
RUN corepack enable
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Public build-time values only (NEXT_PUBLIC_*). Never pass secrets as build args.
RUN pnpm exec next build

# ---------- runtime ----------
FROM node:${NODE_VERSION}-alpine AS runtime
# TODO(pin): FROM node:22-alpine@sha256:<digest> AS runtime
ARG GIT_SHA
ARG BUILD_DATE
LABEL org.opencontainers.image.source="https://github.com/<owner>/anoda" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}"

WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0

# standalone output contains a minimal node_modules and server.js
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
# tiny health probe script (no curl in alpine by default); ships with the service:
#   healthcheck.js: fetch(`http://127.0.0.1:${process.env.PORT}/healthz`).then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))
COPY --from=build --chown=node:node /app/healthcheck.js ./healthcheck.js

USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 CMD ["node", "healthcheck.js"]

CMD ["node", "server.js"]
