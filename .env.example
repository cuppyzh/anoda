# Copy to .env and fill in. `.env` is git-ignored. Never commit real values.
# Every variable a service reads MUST be documented here with a fake value.

# ---- Postgres (docker-compose) ----
POSTGRES_USER=anoda
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=anoda
POSTGRES_PORT=5432

# ---- Shared ----
LOG_LEVEL=debug

# ---- Auth (Google Sign-In, email allowlist) — see docs/contracts/05-security.md ----
# Comma-separated, lower-case. Only these accounts may sign in.
ALLOWED_EMAILS=you@example.com
GOOGLE_OAUTH_CLIENT_ID=000000000000-fake.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=fake-client-secret
# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=replace-with-32-bytes-base64

# ---- Service ports on the host ----
API_PORT=8080
YOMI_API_PORT=8081
PORTAL_UI_PORT=3000
YOMI_UI_PORT=3001

# ---- LLM providers — see docs/contracts/10-ai-integration.md ----
ANTHROPIC_API_KEY=sk-ant-fake
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
LLM_DAILY_BUDGET_USD=5
