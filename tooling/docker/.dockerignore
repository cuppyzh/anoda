# Copy to every service folder as .dockerignore. Keeps secrets, VCS, tests, and dev files out of images.
.git
.gitignore
.github
**/.env
**/.env.*
!**/.env.example
*.md
!README.md
docs
coverage*
**/coverage
**/*_test.go
**/testdata
**/*.test.ts
**/*.test.tsx
tests
e2e
node_modules
.next
out
.turbo
bin
dist
.task
.golangci-cache
.eslintcache
.idea
.vscode
.DS_Store
Thumbs.db
*.log
Dockerfile
.dockerignore
docker-compose*.yml
